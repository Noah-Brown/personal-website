---
import '../styles/global.css';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/inter';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  activeNav?: string;
}

const {
  title,
  description = 'Noah Brown — AI solutions engineer writing about building human-centered AI.',
  activeNav = '',
} = Astro.props;

const navLinks = [
  { label: 'About', href: '/about/', key: 'about' },
  { label: 'Projects', href: '/projects/', key: 'projects' },
  { label: 'Writing', href: '/blog/', key: 'writing' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icon-192.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://noahbrown.io" />
    <meta property="og:image" content="https://noahbrown.io/icon-512.png" />
    <meta property="og:site_name" content="noahbrown.io" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#faf7f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#23262b" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const theme = stored === 'light' || stored === 'dark'
          ? stored
          : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "noahbrown.io",
      "url": "https://noahbrown.io",
      "author": {
        "@type": "Person",
        "name": "Noah Brown",
        "jobTitle": "AI Solutions Engineer"
      }
    })} />
  </head>
  <body class="bg-bg text-text font-serif text-[18px] leading-[1.75] min-h-screen">
    <div class="mx-auto max-w-[68ch] px-5 py-10 md:py-16">

      <header class="mb-14 flex items-baseline justify-between gap-4 flex-wrap">
        <a href="/" class="font-serif text-[19px] font-semibold text-heading no-underline">Noah Brown</a>
        <nav class="flex items-center gap-5 font-sans text-[14px]">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'no-underline transition-colors',
                activeNav === link.key
                  ? 'text-heading'
                  : 'text-text-dim hover:text-heading',
              ]}
            >{link.label}</a>
          ))}
          <ThemeToggle />
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="mt-20 pt-6 border-t border-border font-sans text-[13px] text-text-muted flex items-center gap-4 flex-wrap">
        <a href="https://github.com/noah-brown" class="no-underline hover:text-text-dim transition-colors">GitHub</a>
        <a href="https://www.linkedin.com/in/noahjbrown/" class="no-underline hover:text-text-dim transition-colors">LinkedIn</a>
        <a href="mailto:contact@noahbrown.io" class="no-underline hover:text-text-dim transition-colors">contact@noahbrown.io</a>
      </footer>
    </div>

    <script>
      document.querySelectorAll('a[href^="http"]').forEach(link => {
        if (!(link as HTMLAnchorElement).hostname.includes(location.hostname)) {
          link.setAttribute('target', '_blank');
          link.setAttribute('rel', 'noopener noreferrer');
        }
      });
    </script>
  </body>
</html>
