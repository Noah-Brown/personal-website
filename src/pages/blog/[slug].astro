---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout
  title={`${post.data.title} — Noah Brown`}
  description={post.data.description}
  activeNav="writing"
>
  <article>
    <header class="mb-10">
      <h1 class="font-serif text-[32px] font-semibold text-heading leading-[1.25] mb-3">{post.data.title}</h1>
      <div class="font-sans text-[14px] text-text-muted">{formatDate(post.data.date)}</div>
    </header>

    <div class="prose prose-lg max-w-none
                prose-headings:font-serif prose-headings:font-semibold
                prose-h2:text-[24px] prose-h3:text-[19px]
                prose-p:leading-[1.8]
                prose-a:no-underline hover:prose-a:underline
                prose-img:rounded-md prose-img:border prose-img:border-border">
      <Content />
    </div>
  </article>
</BaseLayout>
