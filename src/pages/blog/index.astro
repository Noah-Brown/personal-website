---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout
  title="Writing — Noah Brown"
  description="Essays and notes by Noah Brown on building human-centered AI."
  activeNav="writing"
>
  <h1 class="font-serif text-[28px] font-semibold text-heading mb-8">Writing</h1>

  {posts.length === 0 ? (
    <p class="text-text-muted">No posts yet.</p>
  ) : (
    <ul class="list-none p-0 m-0 space-y-7">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="text-heading text-[19px] no-underline hover:text-accent transition-colors">
            {post.data.title}
          </a>
          {post.data.description && (
            <p class="text-[16px] text-text-dim leading-[1.7] mt-1">{post.data.description}</p>
          )}
          <div class="font-sans text-[13px] text-text-muted mt-1">{formatDate(post.data.date)}</div>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
