---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const selectedProjects = [
  {
    name: 'SD Legislature Tracker',
    href: 'https://sdleg.vercel.app',
    blurb: 'A civic tool that makes South Dakota’s legislative process legible to the people it governs.',
  },
  {
    name: 'Threadline',
    href: null,
    blurb: 'A news reader that organizes stories into ongoing narratives instead of isolated headlines.',
  },
  {
    name: 'Cutline',
    href: 'https://cut-line.com',
    blurb: 'A daily baseball trivia game built around the pleasure of almost remembering.',
  },
];
---

<BaseLayout title="Noah Brown">
  <section class="mb-14">
    <p class="text-text leading-[1.8] mb-5">
      I'm Noah Brown, an AI solutions engineer. I help organizations adopt AI in ways
      that are useful, honest, and accountable to the people who depend on them. The
      starting point is always a real problem someone has, and the technology earns
      its place by solving it.
    </p>
    <p class="text-text-dim leading-[1.8]">
      I spent years building and running infrastructure: networks, automation, the
      systems everything else stands on. That background shapes how I think about AI.
      It should work like good infrastructure, reliable, understandable, and quietly
      useful in support of human judgment. I write here about building with AI, what
      it changes, and what it shouldn't.
    </p>
  </section>

  <section class="mb-14">
    <h2 class="font-sans text-[13px] font-medium uppercase tracking-[0.12em] text-text-muted border-b border-border pb-2 mb-5">Writing</h2>
    <ul class="list-none p-0 m-0 space-y-5">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="text-heading text-[19px] no-underline hover:text-accent transition-colors">
            {post.data.title}
          </a>
          <div class="font-sans text-[13px] text-text-muted mt-0.5">{formatDate(post.data.date)}</div>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2 class="font-sans text-[13px] font-medium uppercase tracking-[0.12em] text-text-muted border-b border-border pb-2 mb-5">Selected projects</h2>
    <ul class="list-none p-0 m-0 space-y-5">
      {selectedProjects.map((project) => (
        <li>
          {project.href ? (
            <a href={project.href} class="text-heading text-[19px] no-underline hover:text-accent transition-colors">
              {project.name}
            </a>
          ) : (
            <span class="text-heading text-[19px]">{project.name}</span>
          )}
          <p class="text-[16px] text-text-dim leading-[1.7] mt-0.5">{project.blurb}</p>
        </li>
      ))}
    </ul>
    <p class="font-sans text-[14px] mt-6">
      <a href="/projects/" class="text-text-dim no-underline hover:text-heading transition-colors">All projects &rarr;</a>
    </p>
  </section>
</BaseLayout>
