---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    name: 'SD Legislature Tracker',
    year: '2026',
    stack: 'Next.js / Python / SQLite',
    description: 'A civic tool that makes South Dakota’s legislative process legible to citizens — tracking ~350 bills, diffing proposed text against existing statute, and visualizing the state budget.',
    links: [
      { text: 'Live site', href: 'https://sdleg.vercel.app' },
      { text: 'GitHub', href: 'https://github.com/Noah-Brown/sdleg' },
      { text: 'Blog post', href: '/blog/sd-legislature-tracker/' },
    ],
  },
  {
    name: 'Threadline',
    year: '2026',
    status: 'Retired',
    stack: 'FastAPI / React Native / Next.js',
    description: 'A news aggregator that organizes stories into ongoing narrative threads instead of isolated headlines, using Claude for extraction and classification.',
    links: [],
  },
  {
    name: 'Cutline',
    year: '2026',
    stack: 'FastAPI / Next.js / Postgres',
    description: 'A daily MLB grid trivia game: nine player names, some real qualifiers, some imposters designed to feel right and trip you up.',
    links: [
      { text: 'Live site', href: 'https://cut-line.com' },
      { text: 'GitHub', href: 'https://github.com/Noah-Brown/cutline' },
    ],
  },
  {
    name: 'Kalshi Weather Bot',
    year: '2026',
    stack: 'Python / Kalshi API',
    description: 'An automated forecasting and trading system for Kalshi temperature markets, blending NWP model data with live observations to compute calibrated probabilities.',
    links: [],
  },
  {
    name: 'noahbrown.io',
    year: '2026',
    stack: 'Astro / Tailwind',
    description: 'This site — a quiet, essay-first home for writing and projects, with a parchment light mode and slate dark mode.',
    links: [
      { text: 'GitHub', href: 'https://github.com/Noah-Brown/personal-website' },
    ],
  },
  {
    name: 'Fantasy Baseball Draft Tool',
    year: '2026',
    stack: 'Python / Streamlit',
    description: 'A Streamlit app for managing fantasy baseball auction and snake drafts, built on Fangraphs projections and Yahoo position eligibility.',
    links: [
      { text: 'GitHub', href: 'https://github.com/Noah-Brown/Fantasy-Baseball-Draft-Tool' },
    ],
  },
];
---

<BaseLayout
  title="Projects — Noah Brown"
  description="Things Noah Brown has built."
  activeNav="projects"
>
  <h1 class="font-serif text-[28px] font-semibold text-heading mb-3">Projects</h1>
  <p class="text-text-dim mb-10">
    Small, useful things I've built — mostly to keep my opinions about software honest.
  </p>

  <ul class="list-none p-0 m-0 space-y-10">
    {projects.map((project) => (
      <li>
        {project.links[0] ? (
          <a href={project.links[0].href} class="text-heading text-[20px] no-underline hover:text-accent transition-colors">
            {project.name}
          </a>
        ) : (
          <span class="text-heading text-[20px]">{project.name}</span>
        )}
        <p class="text-[16px] text-text-dim leading-[1.7] mt-1">{project.description}</p>
        <div class="font-sans text-[13px] text-text-muted mt-1.5">
          {project.year} &middot; {project.status && <>{project.status} &middot; </>}{project.stack}
          {project.links.map((link) => (
            <>
              {' '}&middot;{' '}
              <a href={link.href} class="text-text-muted underline decoration-border-bright underline-offset-2 hover:text-accent transition-colors">{link.text}</a>
            </>
          ))}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
